{
  "version": 1,
  "description": "Read-only Firebase monitoring and representative stacks. Authentication remains in Firebase CLI; app URLs are followed separately.",
  "fields": [
    {
      "key": "host",
      "label": "Firebase console",
      "type": "string",
      "choices": ["console.firebase.google.com"],
      "default": "console.firebase.google.com"
    },
    {
      "key": "account",
      "label": "Firebase account email",
      "type": "string",
      "description": "Optional: use the existing default Firebase login when empty."
    },
    {
      "key": "intervalSeconds",
      "label": "Polling interval (seconds)",
      "type": "integer",
      "default": 300,
      "minimum": 60,
      "maximum": 86400
    },
    {
      "key": "timeoutSeconds",
      "label": "Read timeout (seconds)",
      "type": "integer",
      "default": 90,
      "minimum": 5,
      "maximum": 300
    },
    {
      "key": "maxPages",
      "label": "Maximum pages",
      "type": "integer",
      "default": 20,
      "minimum": 1,
      "maximum": 100
    },
    {
      "key": "pageSize",
      "label": "Page size",
      "type": "integer",
      "default": 100,
      "minimum": 1,
      "maximum": 100
    },
    {
      "key": "lookbackDays",
      "label": "Lookback (days)",
      "type": "integer",
      "default": 7,
      "minimum": 1,
      "maximum": 89
    },
    {
      "key": "states",
      "label": "Issue states",
      "type": "strings",
      "choices": ["OPEN", "CLOSED", "MUTED"],
      "default": ["OPEN"],
      "description": "Choose one state, or all three (one per line). Empty also means all. Pairs are not supported. Source URL filters take precedence."
    },
    {
      "key": "errorTypes",
      "label": "Error types",
      "type": "strings",
      "choices": ["FATAL", "NON_FATAL", "ANR"],
      "default": ["FATAL"]
    },
    {
      "key": "versions",
      "label": "Exact version display names",
      "type": "strings",
      "default": [],
      "description": "One per line, for example 1.2 (42). Empty means all."
    },
    {
      "key": "minEvents",
      "label": "Minimum events",
      "type": "integer",
      "default": 1,
      "minimum": 1
    },
    {
      "key": "minUsers",
      "label": "Minimum users",
      "type": "integer",
      "default": 0,
      "minimum": 0
    },
    {
      "key": "notifyCounts",
      "label": "Notify count changes",
      "type": "boolean",
      "default": false
    },
    {
      "key": "autoStacks",
      "label": "Attach representative stacks automatically",
      "type": "boolean",
      "default": true
    },
    {
      "key": "maxSamplesPerPoll",
      "label": "New stack attempts per poll",
      "type": "integer",
      "default": 20,
      "minimum": 1,
      "maximum": 100
    }
  ]
}
